# Ansible: Setup nginx with custom config
---
- name: Setup nginx with custom config
  hosts: all
  become: yes

  tasks:
    - name: Install nginx
      yum:
        name: nginx
        state: present
    
    - name: copy custom config
      copy:
        src: nginx.conf
        dest: /etc/nginx/

    - name: Start nginx service
      service:
        name: nginx
        state: started
        enabled: yes

# Provision ec2 with iam role

resource "aws_iam_role" "ec2_role" {
    name = "pathnex-ec2-role"
    assume_role_policy = jsonencode ({
        Version = "2017-10-12"
        Statement = [
            Action = "sts:AssumeRole"
            Effect = "Allow"
            Principal = {
                Service = "ec2.amazonaws.com"
            }
        ]
    })
}

resource "aws_instance" "pathnex_ec2" {
    ami = "ami-abcd1234abcd1234"
    instance_type = "t3.micro"
    iam_instance_profile = aws_iam_role.ec2_role.name

    tags = {
        Name = "pathnex-ec2"
    }
}

# Kubernetes - Config map and secrets

apiVersion: v1
kind: ConfigMap
metadata:
  name: pathnex-config
data:
  app.properties: |
    key: value

---

apiVersion: v1
kind: Secret
metadata:
  name: pathnex-secret
type: opaque
data:
  password: cGF0aG5leHBhc3M=


# Archieve logs

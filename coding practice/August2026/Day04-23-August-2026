# Basic CICD concept with Jenkins

# Jenkinsfile with checkout, test and Deploy stages
pipeline {
  agent any 
  stages {
    stage ('checkout') {
      steps {
        echo "clone repo"
      }
    }

    stage ('Build') {
      steps {
 	echo "building project"
      }
    }

    stage ('Test') {
      steps {
	echo "Running Test'
      }
    }

    stage ('Deploy') {
      steps {
        echo "Deploying code"
      }
    }
  }
}

# Install and configure nginx
---
- name: Install and Configure Nginx
  hosts: all
  become: yes

  tasks:
  - name: Install nginx
    yum:
      name: nginx
      state: present
  - name: Configure Nginx
    template:
      src: nginx.conf.j2
      dest: /etc/nginx/nginx.conf
  - name: Started Nginx
    service:
      name: nginx
      state: started
      enabled: yes

# Terraform — EC2 with Security Group
resource "aws_security_group" "asg" {
    name = "example_asg"
    description = "allow ssh and http port"

    ingress = {
    	from_port = 22
	    to_port = 22
	    protocol = "tcp"
	    cidr_blocks = ["0.0.0.0/0"]
    }

    ingress = {
      from_port = 80
      to_port = 80
      protocol = "tcp"
      cidr_blocks = ["0.0.0.0/0"]
    }

    egress = {
      from_port = 0
      to_port = 0
      protocol = "-1"
      cidr_blocks = ["0.0.0.0/0"]
    }
}


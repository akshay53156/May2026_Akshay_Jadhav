# Ansible - Install Docker

---
- name: Install Docker and Start Service
  hosts: all
  become: yes

  tasks:
    - name: Install Docker
      yum:
        name: docker
        state: present
    - name: Start Docker
      service:
        name: docker
        state: started
        enabled: yes

# Provisioning EC2 with VPC

provider "aws" {
    region = "us-east-1"
}

resource "aws_vpc" "pathnex_vpc" {
    cidr_block = "10.0.0.0/16"

    tags = {
        Name = "Pathnex-VPC"
    }
}

resource "aws_subnet" "pathnex_public_subnet" {
    vpc_id = aws_vpc.pathnex_vpc.id
    cidr_block = "10.0.1.0/24"
    map_public_ip_on_launch = true

    tags = {
        Name = "Pathnex-PUB-SUBNET"
    }
}

resource "aws_internet_gateway" "pathnex_igw" {
    vpc_id = aws_vpc.pathnex_vpc.id

    tags = {
        Name = "Pathnex-IGW"
    }
}

resource "aws_route_table" "pathnex_rt" {
    vpc_id = aws_vpc.pathnex_vpc.id

    route {
        cidr_block = "0.0.0.0/0"
        gateway_id = aws_internet_gateway.pathnex_igw.id
    }

    tags = {
        Name = "Pathnex-RT"
    }
}

resource "aws_route_table_association" "pathnex_public_rta" {
    subnet_id = aws_subnet.pathnex_public_subnet.id
    route_table_id = aws_route_table.pathnex_rt.id
}

resource "aws_instance" "pathnex_webserver" {
    ami = "abcd1234abcd1234"
    instance_type = "t3.medium"
    subnet_id = aws_subnet.pathnex_public_subnet.id
    associate_public_ip_address = true

    tags = {
        Name = "Pathnex_EC2"
    }
}
  

# Kubernetes pod with volume mount

apiVersion: v1
kind: Pod
metadata:
  app: pathnex-pod
spec:
  containers:
    - name: web
      image: nginx
      volumeMounts:
        - mountPath: /usr/share/nginx/html
          name: html-volume
  volumes:
    - name: html-volume
      hostPath:
        path: /data
        type: directory

# check for running services

#!/bin/bash
services = ("nginx", "docker", "httpd")
for service in "{services[@]}"
do
  if systemctl is-active --quiet $service; then
    echo "$service is running"
  else
    echo "$service is not running"
  fi
done

